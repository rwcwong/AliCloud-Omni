# Leave these empty to use the same-origin proxy paths configured by the app.
# Set HTTPS/WSS URLs only when the API gateway has valid browser CORS/TLS.
VITE_API_BASE_URL=
VITE_API_WS_NODE_1=
VITE_API_WS_NODE_2=

# Same CARTO dark_all / voyager basemaps as OmniOS-main-1008.
# Put the real, authorized key in .env.local, not in source control.
# If blank, Vite also checks the sibling OmniOS-main-1008 environment for this key only.
# Missing keys show a configuration notice; no watermarked tiles are requested.
VITE_CARTO_API_KEY=
